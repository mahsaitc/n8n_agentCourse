      "parameters": {
        "jsCode": "const r=$input.first().json;const d=r.data;const e=r.event;const now=new Date();\nconst access=d.attendance_mode==='online'?e.online_url:e.venue;\nif(!access)throw new Error('اطلاعات ورود/محل رویداد در Events کامل نیست');\nif(!e.owner_email||!e.owner_bale_chat_id||!e.bale_bot_username)throw new Error('مقصد اعلان مسئول یا نام بازوی بله در Events کامل نیست');\nreturn [{json:{registration_id:'REG-'+$execution.id,registration_key:r.registration_key,event_id:d.event_id,full_name:d.full_name,email:d.email,department:d.department,attendance_mode:d.attendance_mode,special_needs:d.special_needs,status:'confirmed',priority:d.special_needs?'P2':'P3',destination:e.owner_email,access_info:access,created_at:now.toISOString(),source:r.source,link_token:r.link_token,link_expires_at:new Date(now.getTime()+24*3600000).toISOString(),link_token_used:'',bale_chat_id:'',event_title:e.title,event_date:e.event_date,owner_email:e.owner_email,owner_bale_chat_id:String(e.owner_bale_chat_id),bale_bot_username:e.bale_bot_username}}];"
