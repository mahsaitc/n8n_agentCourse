      "parameters": {
        "jsCode": "const src=$input.first().json;\nconst portal=!!src.body; const r=portal?src.body:src;\nconst clean=v=>typeof v==='string'?v.trim():'';\nconst email=clean(r.email).toLowerCase();\nconst mode=({'آنلاین':'online','حضوری':'in_person',online:'online',in_person:'in_person'})[clean(r.attendance_mode)]||'';\nconst data={full_name:clean(r.full_name),email,department:clean(r.department),event_id:clean(r.event_id).toUpperCase(),attendance_mode:mode,special_needs:clean(r.special_needs)};\nconst errors=[];\nfor(const key of ['full_name','email','department','event_id'])if(!data[key])errors.push(key+' الزامی است');\nif(!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email))errors.push('قالب ایمیل معتبر نیست');\nif(!mode)errors.push('نحوه شرکت معتبر نیست');\nreturn [{json:{data,source:portal?'portal':'form',valid:errors.length===0,errors,registration_key:data.event_id+'|'+email}}];"
