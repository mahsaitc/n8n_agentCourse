      "parameters": {
        "jsCode": "const input=$('Normalize Inputs').first().json; const rows=$input.all().map(i=>i.json).filter(r=>r.event_id);\nconst event=rows.find(r=>String(r.event_id).toUpperCase()===input.data.event_id);\nlet reason='';if(!event)reason='رویداد پیدا نشد';else if(String(event.registration_open).toLowerCase()!=='true')reason='ثبت‌نام این رویداد بسته است';\nelse if(!String(event.allowed_modes).split(',').map(v=>v.trim()).includes(input.data.attendance_mode))reason='شیوه شرکت برای این رویداد مجاز نیست';\nreturn [{json:{...input,event:event||{},eligible:!reason,reason}}];"
      },
