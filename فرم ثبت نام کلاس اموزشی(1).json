      "parameters": {
        "jsCode": "const r=$('Build Registration Record').first().json;\nconst link='https://ble.ir/'+r.bale_bot_username+'?start='+r.link_token;\nconst attendee='سلام '+r.full_name+'؛ ثبت‌نام شما در '+r.event_title+' تأیید شد.\\nشماره پیگیری: '+r.registration_id+'\\nزمان: '+r.event_date+'\\nنحوه شرکت: '+r.attendance_mode+'\\nاطلاعات ورود/محل: '+r.access_info+'\\nبرای دریافت تأیید در بله، این لینک را باز کنید: '+link;\nconst admin='ثبت‌نام جدید: '+r.full_name+'\\nدوره: '+r.event_title+'\\nایمیل: '+r.email+'\\nواحد: '+r.department+'\\nنحوه شرکت: '+r.attendance_mode+'\\nاولویت بررسی: '+r.priority+'\\nنیاز ویژه: '+(r.special_needs||'ندارد')+'\\nشماره: '+r.registration_id;\nconst list=[['attendee','email',r.email,attendee,'pending'],['owner','email',r.owner_email,admin,'pending'],['owner','bale',r.owner_bale_chat_id,admin,'pending'],['attendee','bale','',attendee.split('\\nبرای دریافت')[0],'waiting_link']];\nreturn list.map(([role,channel,recipient,text,status])=>({json:{job_id:r.registration_id+':'+role+':'+channel,registration_id:r.registration_id,role,channel,recipient,subject:'ثبت‌نام '+r.event_title,text,status,last_error:'',updated_at:new Date().toISOString()}}));"
