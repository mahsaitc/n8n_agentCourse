    {
      "parameters": {
        "jsCode": "// Read the real Bale update, without assuming all providers wrap it identically.\nconst src = $input.first().json ?? {};\nlet update = src.body ?? src;\n\nif (typeof update === 'string') {\n  try { update = JSON.parse(update); } catch { update = {}; }\n}\nif (update?.body?.message && !update.message) update = update.body;\nif (update?.update?.message && !update.message) update = update.update;\nif (update?.data?.message && !update.message) update = update.data;\n\nconst message = update.message ?? update.edited_message ?? {};\nconst text = String(message.text ?? '')\n  .replace(/[\\u200B\\u200C\\u200D\\uFEFF]/g, '')\n  .trim();\n\n// Supported: /start TOKEN, /start@BotName TOKEN, TOKEN pasted by the user,\n// or a full ble.ir link pasted into the private chat.\nconst fromStart = text.match(/^\\/start(?:@[a-zA-Z0-9_]+)?\\s+([a-fA-F0-9]{24,128})$/);\nconst fromPlain = text.match(/^([a-fA-F0-9]{24,128})$/);\nconst fromLink = text.match(/^https?:\\/\\/(?:www\\.)?ble\\.ir\\/[^\\s?]+\\?start=([a-fA-F0-9]{24,128})(?:&[^\\s]*)?$/i);\nconst token = String((fromStart ?? fromPlain ?? fromLink)?.[1] ?? '').toLowerCase();\n\nconst chatId = message.chat?.id;\nconst senderId = message.from?.id;\nconst chatType = String(message.chat?.type ?? '').toLowerCase();\nconst hasChatId = chatId !== undefined && chatId !== null && String(chatId) !== '';\n\n// When Bale explicitly identifies a private chat, the chat.type is decisive.\n// Otherwise, infer private only if both IDs exist and match.\nconst isPrivate = chatType === 'private' ||\n  (!chatType && hasChatId && senderId !== undefined && senderId !== null &&\n   String(senderId) === String(chatId));\n\nlet reason = 'ok';\nif (!message || !message.chat) reason = 'missing_message_or_chat';\nelse if (!text) reason = 'missing_message_text';\nelse if (!token) reason = /^\\/start(?:\\s|@|$)/i.test(text)\n  ? 'start_missing_or_invalid_token'\n  : 'unexpected_command_or_token';\nelse if (!hasChatId) reason = 'missing_chat_id';\nelse if (!isPrivate) reason = 'chat_not_private';\n\nreturn [{ json: {\n  valid: reason === 'ok',\n  token,\n  chat_id: hasChatId ? String(chatId) : '',\n  reason,\n  diagnostics: {\n    chat_type: chatType || '(missing)',\n    has_start_command: /^\\/start(?:\\s|@|$)/i.test(text),\n    token_length: token.length,\n    sender_matches_chat: senderId != null && hasChatId\n      ? String(senderId) === String(chatId) : null,\n    has_message: !!message.chat,\n  },\n} }];"
      },
