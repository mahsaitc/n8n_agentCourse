    {
      "parameters": {
        "jsCode": "const input = $('Extract Private Start').first().json;\nconst token = String(input.token ?? '').trim().toLowerCase();\nconst rows = $input.all().map(i => i.json);\nconst row = rows.find(r =>\n  String(r.link_token ?? '').trim().toLowerCase() === token\n);\n\nconst usedValue = String(row?.link_token_used ?? '').trim().toLowerCase();\nconst used = !['', 'false', '0', 'no'].includes(usedValue);\nconst expiry = Date.parse(String(row?.link_expires_at ?? ''));\n\nlet reason = 'ok';\nif (!row) reason = 'token_not_found_in_registrations';\nelse if (used) reason = 'token_already_used';\nelse if (!Number.isFinite(expiry)) reason = 'invalid_expiration_date';\nelse if (expiry <= Date.now()) reason = 'token_expired';\n\nreturn [{ json: {\n  valid: reason === 'ok',\n  reason,\n  registration_id: row?.registration_id || '',\n  chat_id: input.chat_id,\n  token_expires_at: row?.link_expires_at || '',\n} }];"
      },
